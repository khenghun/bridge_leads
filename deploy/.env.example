# Copy to /opt/bridge_leads/.env (lead stack) or /opt/bridge_play/.env (play
# stack) on the VPS, next to that stack's docker-compose.prod.yml. Each stack
# pins its own tag.

# Image tag the stack runs. Leave unset for latest; pin a commit SHA to hold
# the stack at a version (the deploy workflow's image_tag input overrides
# this for a single run).
#IMAGE_TAG=latest

# DOMAIN is no longer used: TLS + routing moved to the shared edge stack at
# /opt/edge (source of truth: the FBO repo's deploy/edge/), which hardcodes
# this app's site block for bridge-leads.icycookie.xyz.

# --- play stack only: the judge backend (play v1.5) -------------------------
# The play compose file passes this whole file into the backend container
# (env_file), so it must exist there even if every line below stays unset.
# `local` runs the expert filter's judgements on this box; `lambda` sends
# them to the bridge-play-worker function (any failed group is judged
# locally). The key belongs to the invoke-only IAM user — never to the deploy
# role. Create the file with `umask 077`.
#BRIDGE_JUDGE_BACKEND=local
#BRIDGE_WORKER_FUNCTION=bridge-play-worker
#BRIDGE_WORKER_GROUP=4            # judgements per invoke
#BRIDGE_WORKER_CONCURRENCY=64     # invokes in flight per process
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=ap-southeast-1

