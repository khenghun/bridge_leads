# Copy to /opt/bridge_leads/.env on the VPS (next to docker-compose.prod.yml).

# Domain Caddy serves + obtains the Let's Encrypt cert for.
DOMAIN=yourdomain.example

# Image tag the stack runs. Leave unset for latest; pin a commit SHA to hold
# the stack at a version (the deploy workflow's image_tag input overrides
# this for a single run).
#IMAGE_TAG=latest
